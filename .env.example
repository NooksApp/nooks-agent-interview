# Copy to .env — it is loaded automatically on start (src/env.ts).

# Interview setup (provided by your interviewer — no Anthropic key needed):
INTERVIEW_GATEWAY_URL=https://interview-llm-gateway.nooks.workers.dev
INTERVIEW_TOKEN=iv1.your-name.1234567890.abcdef...

# OR, if you have your own Anthropic key instead:
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# AGENT_MODEL=claude-sonnet-5    # the model that drafts
